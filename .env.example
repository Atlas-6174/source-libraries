# Copy to .env and adjust. No secrets are required by this stack.

# Interface the published port binds to. Use 0.0.0.0 to expose it on the LAN,
# and only behind a TLS reverse proxy for anything beyond a trusted network.
HOST_BIND=127.0.0.1
# Host port mapped to the container's 8080.
HOST_PORT=8080
# Image to run; override to pull a published release instead of building.
# Prefer an exact SemVer tag (or a digest) over a moving tag.
# IMAGE=ghcr.io/atlas-6174/source-libraries:0.1.0
